# ---- Banco de dados (obrigatório) ----
# Supabase: Project Settings > Database > Connection string (use a do "Session pooler" ou a direta)
# Na Vercel, prefira a URL do pooler (Supabase: porta 6543, "Transaction pooler").
DATABASE_URL=postgresql://usuario:senha@host:5432/postgres
# true para Supabase, Neon, Render etc. (exigem SSL). false para Postgres local.
DB_SSL=true

# ---- Login do painel (obrigatório) ----
# Mínimo 32 caracteres. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Duração da sessão (ex.: 30m, 8h, 1d)
JWT_EXPIRA=8h

# ---- Opcional ----
# Restringe quem pode chamar a API. Sem isso, qualquer origem é aceita.
# CORS_ORIGINS=https://joaojordaosilva.github.io,http://localhost:5173
PORT=3001
GEMINI_API_KEY=
